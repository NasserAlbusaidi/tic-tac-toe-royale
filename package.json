{
  "name": "tic-tac-toe-royale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:network": "HOST=0.0.0.0 VITE_HOST=0.0.0.0 concurrently -k -n server,client -c cyan,magenta \"node server/index.mjs\" \"vite --host 0.0.0.0\"",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build && node --check server/index.mjs && node --check server/game-engine.mjs",
    "preview": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.22.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
